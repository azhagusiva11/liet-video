<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LIET — 60s Product Walkthrough v2</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');
:root{
  --bg:#0A0E13; --panel:#0F1419; --line:#1F2937;
  --teal:#14B8A6; --red:#EF4444; --orange:#C2410C; --green:#22C55E;
  --txt:#E5E7EB; --dim:#9CA3AF; --faint:#6B7280;
  --mono:'JetBrains Mono',ui-monospace,monospace;
  --ui:'Inter',system-ui,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box;}
html,body{background:#000;height:100%;overflow:hidden;}
#stage{
  position:absolute;top:50%;left:50%;width:1080px;height:1920px;
  transform-origin:center center;background:var(--bg);font-family:var(--ui);
  overflow:hidden;
}
/* ---------- persistent chrome ---------- */
.corner{position:absolute;top:26px;left:32px;z-index:96;font-family:var(--mono);font-size:16px;letter-spacing:2px;color:var(--faint);}
.apphdr{
  position:absolute;top:64px;left:48px;right:48px;z-index:80;
  display:flex;align-items:center;gap:18px;
  padding:26px 30px;background:var(--panel);border:1px solid var(--line);border-radius:18px;
}
.apphdr .sq{width:34px;height:34px;border-radius:9px;background:var(--teal);flex:0 0 auto;}
.apphdr .nm{font-family:var(--mono);font-size:24px;font-weight:600;letter-spacing:3px;color:var(--txt);}
.apphdr .opd{margin-left:auto;display:flex;align-items:center;gap:10px;font-family:var(--mono);font-size:18px;color:var(--green);letter-spacing:1.5px;}
.apphdr .opd .gd{width:11px;height:11px;border-radius:50%;background:var(--green);box-shadow:0 0 10px rgba(34,197,94,.7);animation:pul 2s infinite;}
@keyframes pul{0%,100%{opacity:1;}50%{opacity:.45;}}
/* caption strip */
.cap{
  position:absolute;top:172px;left:48px;right:48px;z-index:79;
  font-size:25px;font-style:italic;color:var(--dim);opacity:0;line-height:1.4;
}
/* rec bar */
.recbar{
  position:absolute;left:48px;right:48px;bottom:54px;z-index:85;
  background:var(--panel);border:1px solid var(--line);border-radius:18px;
  padding:22px 30px;display:flex;align-items:center;gap:26px;
  opacity:0;pointer-events:none;
}
.recpill{display:flex;align-items:center;gap:12px;font-family:var(--mono);font-size:24px;font-weight:600;color:var(--red);white-space:nowrap;}
.recpill .rd{width:14px;height:14px;border-radius:50%;background:var(--red);animation:pul 1.1s infinite;}
.wave{flex:1;display:flex;align-items:center;gap:4px;height:64px;overflow:hidden;}
.wave i{flex:0 0 auto;width:5px;border-radius:3px;background:var(--teal);height:8px;opacity:.85;}
#stage.recording .wave i{animation:wv 1s ease-in-out infinite alternate;}
@keyframes wv{from{height:6px;opacity:.4;}to{height:52px;opacity:1;}}
#stage.paused *{animation-play-state:paused !important;}

/* ---------- scenes ---------- */
.scene{position:absolute;inset:0;padding:236px 48px 170px;opacity:0;pointer-events:none;z-index:10;display:flex;flex-direction:column;}
[data-a]{opacity:0;}

/* ---------- scene 0 — patient + memory + mic ---------- */
.pcard{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:30px 34px;display:flex;align-items:center;gap:22px;flex-wrap:wrap;}
.pcard .pid{font-family:var(--mono);font-size:30px;font-weight:600;color:var(--txt);letter-spacing:1px;}
.chip{font-family:var(--mono);font-size:19px;color:var(--dim);background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:30px;padding:9px 18px;white-space:nowrap;}
.chip.teal{color:var(--teal);border-color:rgba(20,184,166,.4);background:rgba(20,184,166,.08);}
.memcard{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:24px 28px;margin-top:20px;}
.memcard h3{font-family:var(--mono);font-size:18px;letter-spacing:3px;color:var(--dim);margin-bottom:14px;font-weight:600;}
.memcard .mtxt{font-size:24px;color:var(--txt);line-height:1.45;}
.memcard .mtxt b{color:var(--teal);font-weight:600;}
.miczone{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:34px;}
.micbig{
  width:280px;height:280px;border-radius:50%;background:var(--panel);
  border:2px solid rgba(20,184,166,.5);display:flex;align-items:center;justify-content:center;position:relative;
  box-shadow:0 0 80px rgba(20,184,166,.12);
}
.micbig::before{content:"";position:absolute;inset:-2px;border-radius:50%;border:2px solid rgba(20,184,166,.35);animation:rip 2.6s ease-out infinite;}
@keyframes rip{0%{transform:scale(1);opacity:.8;}100%{transform:scale(1.45);opacity:0;}}
.micbig.rec{border-color:var(--red);box-shadow:0 0 90px rgba(239,68,68,.25);}
.micbig.rec::before{border-color:rgba(239,68,68,.45);animation-duration:1.2s;}
.michint{font-size:28px;color:var(--dim);text-align:center;line-height:1.4;}
.recstate{font-family:var(--mono);font-size:30px;font-weight:600;color:var(--red);display:none;align-items:center;gap:14px;}
.recstate .rd{width:16px;height:16px;border-radius:50%;background:var(--red);animation:pul 1.1s infinite;}
.miczone.live .michint{display:none;}
.miczone.live .recstate{display:flex;}

/* ---------- scene 1 — transcript + capture ---------- */
.tpanel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:32px 36px;display:flex;flex-direction:column;gap:22px;min-height:720px;}
.tl{font-size:31px;line-height:1.45;color:var(--txt);display:none;}
.tl.doc{color:var(--teal);}
.tl .w{opacity:0;}
.tl .w.s{opacity:1;}
.tl.go{display:block;}
.tl.typing::after{content:"";display:inline-block;width:4px;height:32px;background:var(--txt);margin-left:8px;vertical-align:-6px;animation:blink .8s steps(1) infinite;}
@keyframes blink{50%{opacity:0;}}
.cappanel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:24px 28px;margin-top:20px;}
.cappanel h3{font-family:var(--mono);font-size:19px;letter-spacing:3px;color:var(--green);margin-bottom:14px;}
.chiprow{display:flex;flex-wrap:wrap;gap:12px;}
.cchip{font-family:var(--ui);font-size:21px;color:var(--txt);background:rgba(34,197,94,.08);border:1px solid rgba(34,197,94,.35);border-radius:12px;padding:10px 16px;display:flex;align-items:center;gap:10px;}
.cchip .ck{color:var(--green);font-weight:700;}
.cchip.neg{background:rgba(255,255,255,.03);border-color:var(--line);color:var(--dim);}
.cchip.neg .ck{color:var(--faint);}

/* ---------- scene 2 — exam ---------- */
.exwrap{flex:1;display:flex;flex-direction:column;justify-content:center;gap:30px;}
.expanel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:34px 38px;}
.expanel h3{font-family:var(--mono);font-size:20px;letter-spacing:3px;color:var(--teal);margin-bottom:24px;}
.exrow{display:flex;align-items:baseline;gap:16px;font-size:29px;color:var(--txt);padding:13px 0;line-height:1.35;}
.exrow .ek{color:var(--teal);font-weight:700;flex:0 0 auto;}
.exrow.neg{color:var(--dim);}
.exrow.neg .ek{color:var(--faint);}
.exnote{font-size:21px;color:var(--faint);font-style:italic;}

/* ---------- scene 3 — processing ---------- */
.procwrap{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:40px;}
.stg{display:flex;align-items:center;gap:24px;font-size:34px;color:var(--faint);}
.stg .ic{width:44px;height:44px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;}
.stg .sp{width:34px;height:34px;border-radius:50%;border:4px solid var(--line);border-top-color:var(--teal);animation:spn .8s linear infinite;display:none;}
@keyframes spn{to{transform:rotate(360deg);}}
.stg .ok{display:none;color:var(--green);font-size:36px;font-weight:700;}
.stg.run{color:var(--txt);} .stg.run .sp{display:block;}
.stg.done{color:var(--txt);} .stg.done .ok{display:block;}

/* ---------- scene 4 — note ---------- */
.notewrap{flex:1;display:flex;flex-direction:column;justify-content:center;}
.note{background:#F8FAFC;border-radius:20px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 40px 90px rgba(0,0,0,.5);}
.notehd{display:flex;align-items:center;justify-content:space-between;padding:26px 36px;border-bottom:1.5px solid #E2E8F0;}
.notehd .nt{font-size:29px;font-weight:700;color:#0F172A;}
.gentag{font-family:var(--mono);font-size:17px;color:#15803D;background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.4);border-radius:30px;padding:8px 16px;letter-spacing:.5px;}
.notebody{padding:26px 36px;display:flex;flex-direction:column;gap:22px;}
.nlab{font-family:var(--mono);font-size:17px;letter-spacing:3px;color:#64748B;margin-bottom:9px;}
.nhist{font-size:23px;line-height:1.5;color:#1E293B;}
.nhist .w{opacity:0;} .nhist .w.s{opacity:1;}
.nbody{font-size:23px;line-height:1.5;color:#1E293B;}
.medrow{display:flex;align-items:baseline;gap:14px;font-size:22px;color:#1E293B;padding:5px 0;}
.mtag{font-family:var(--mono);font-size:14px;font-weight:600;letter-spacing:1px;border-radius:7px;padding:6px 12px;flex:0 0 auto;background:#DBEAFE;color:#1D4ED8;border:1px solid #BFDBFE;}
.nfoot{padding:20px 36px;border-top:1.5px solid #E2E8F0;font-size:18px;color:#94A3B8;line-height:1.5;}

/* ---------- scene 5 — actions ---------- */
.s5wrap{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:26px;}
.bigbtn{width:660px;padding:28px;border-radius:18px;text-align:center;font-size:29px;font-weight:600;position:relative;}
.bigbtn.print{background:var(--teal);color:#04211D;box-shadow:0 0 60px rgba(20,184,166,.25);}
.bigbtn.ghost{background:rgba(255,255,255,.04);border:1.5px solid var(--line);color:var(--txt);}
.bigbtn.wa{background:rgba(34,197,94,.14);border:1.5px solid var(--green);color:var(--green);}
.devchip{position:absolute;top:-14px;right:-12px;font-family:var(--mono);font-size:13px;letter-spacing:1.5px;color:#FF9A5C;background:#1a1208;border:1px solid rgba(232,131,58,.55);border-radius:20px;padding:5px 12px;}
.tooltip{
  width:660px;background:rgba(194,66,28,.12);border:1.5px solid var(--orange);border-radius:14px;
  padding:18px 24px;font-size:22px;color:#F3C9AE;line-height:1.45;
}

/* ---------- scene 6 — printed sheet ---------- */
.printwrap{flex:1;display:flex;flex-direction:column;gap:22px;}
.devtag{font-family:var(--mono);font-size:19px;letter-spacing:3px;color:#FF9A5C;font-weight:600;display:flex;align-items:center;gap:14px;}
.devtag::before{content:"";width:34px;height:2px;background:#FF9A5C;}
.sheet{
  background:#FFFFFF;border-radius:14px;overflow:hidden;display:flex;flex-direction:column;
  box-shadow:0 50px 110px rgba(0,0,0,.6);padding:40px 48px;color:#1E293B;min-height:1080px;
}
.lhead{display:flex;justify-content:space-between;align-items:baseline;border-bottom:2.5px solid #0F172A;padding-bottom:18px;}
.lhead .cl{font-size:34px;font-weight:700;color:#0F172A;}
.lhead .cl i{font-style:normal;color:var(--teal);}
.lhead .dr{text-align:right;font-size:18px;color:#475569;line-height:1.5;}
.prow{display:flex;justify-content:space-between;font-family:var(--mono);font-size:19px;color:#475569;padding:16px 0;border-bottom:1px solid #E2E8F0;}
.rxh{font-size:40px;font-weight:700;color:#0F172A;margin:20px 0 4px;font-family:Georgia,serif;}
.rxitem{font-size:24px;color:#1E293B;line-height:1.5;padding:9px 0;display:flex;gap:14px;align-items:baseline;}
.rxitem .n{font-family:var(--mono);font-size:18px;color:#94A3B8;flex:0 0 30px;}
.rxinv{margin-top:16px;font-size:21px;color:#475569;}
.rxinv b{color:#0F172A;font-weight:600;}
.rxrev{margin-top:12px;font-size:22px;color:#0F172A;font-weight:600;}
.sfoot{margin-top:auto;display:flex;justify-content:space-between;align-items:flex-end;padding-top:24px;}
.sfoot .sg{font-family:Georgia,serif;font-style:italic;font-size:30px;color:#334155;border-top:1px solid #CBD5E1;padding-top:10px;}
.sfoot .st{font-family:var(--mono);font-size:15px;color:#94A3B8;letter-spacing:1px;text-align:right;line-height:1.6;}

/* ---------- end card ---------- */
.endcard{position:absolute;inset:0;z-index:88;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:28px;opacity:0;pointer-events:none;}
.endcard .wm{font-size:110px;font-weight:700;color:var(--txt);letter-spacing:-2px;}
.endcard .wm i{font-style:normal;color:var(--teal);}
.endcard .sub{font-family:var(--mono);font-size:26px;letter-spacing:3px;color:var(--dim);}
.endcard .tag{font-size:40px;color:var(--txt);font-weight:600;}
.endcard .site{font-family:var(--mono);font-size:26px;color:var(--teal);letter-spacing:1px;}
.endcard .tiny{font-size:19px;color:var(--faint);margin-top:22px;}

/* ---------- ripple ---------- */
.ripple{
  position:absolute;width:30px;height:30px;border-radius:50%;
  background:rgba(255,255,255,.35);border:2px solid rgba(255,255,255,.6);
  transform:translate(-50%,-50%) scale(1);pointer-events:none;z-index:99;
  animation:ripx .55s ease-out forwards;
}
@keyframes ripx{to{transform:translate(-50%,-50%) scale(5);opacity:0;}}
</style>
</head>
<body>
<div id="stage">
  <div class="corner">PRODUCT WALKTHROUGH · SIMULATED SESSION</div>
  <div class="apphdr">
    <span class="sq"></span><span class="nm">LIET · CLINIC SPACE</span>
    <span class="opd"><span class="gd"></span>OPD ACTIVE</span>
  </div>
  <div class="cap" id="cap"></div>

  <!-- SCENE 0 — patient + previous visit + mic -->
  <section class="scene" id="sc0" data-screen-label="01">
    <div class="pcard" data-a>
      <span class="pid">Mrs. ___ · 41 F</span>
      <span class="chip teal">Returning patient</span>
      <span class="chip">Tamil–English (Auto)</span>
    </div>
    <div class="memcard" data-a>
      <h3>PREVIOUS VISIT</h3>
      <div class="mtxt">Last seen <b>3 months ago</b> — UTI, self-medicated, <b>no culture taken</b>.</div>
    </div>
    <div class="miczone" id="miczone" data-a>
      <div class="micbig" id="micbig">
        <svg width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="#14B8A6" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/></svg>
      </div>
      <div class="michint">Press Record — speak naturally, any language</div>
      <div class="recstate"><span class="rd"></span>● REC <span class="rectime">00:00</span></div>
    </div>
  </section>

  <!-- SCENE 1 — consult transcript + capture -->
  <section class="scene" id="sc1" data-screen-label="02">
    <div class="tpanel" data-a>
      <p class="tl doc" id="t0">Good morning — what's bothering you?</p>
      <p class="tl" id="t1">I've had fever for three days.</p>
      <p class="tl doc" id="t2">Any cough, throat pain, abdominal pain — or burning while passing urine?</p>
      <p class="tl" id="t3">Yes — burning while passing urine. Five days now.</p>
      <p class="tl doc" id="t4">Back pain, vomiting, chills?</p>
      <p class="tl" id="t5">No back pain, no vomiting — some chills. This keeps happening… for a year I get fever and burning urine, take antibiotics from the chemist, it settles, then it comes back.</p>
      <p class="tl doc" id="t6">Let me examine you.</p>
    </div>
    <div class="cappanel" data-a>
      <h3>CAPTURING</h3>
      <div class="chiprow">
        <span class="cchip" data-a><span class="ck">✓</span>Fever — 3 days</span>
        <span class="cchip" data-a><span class="ck">✓</span>Dysuria — 5 days</span>
        <span class="cchip" data-a><span class="ck">✓</span>Chills</span>
        <span class="cchip" data-a><span class="ck">✓</span>Recurrent UTI — 1 yr, self-medicated</span>
        <span class="cchip neg" data-a><span class="ck">✕</span>No back pain</span>
        <span class="cchip neg" data-a><span class="ck">✕</span>No vomiting</span>
      </div>
    </div>
  </section>

  <!-- SCENE 2 — exam findings -->
  <section class="scene" id="sc2" data-screen-label="03">
    <div class="exwrap">
      <div class="expanel" data-a>
        <h3>EXAM — CAPTURED AS DICTATED</h3>
        <div class="exrow neg" data-a><span class="ek">✕</span>No pallor</div>
        <div class="exrow" data-a><span class="ek">✓</span>Hypogastric tenderness</div>
        <div class="exrow neg" data-a><span class="ek">✕</span>No flank tenderness</div>
        <div class="exrow neg" data-a><span class="ek">✕</span>Rest of examination normal</div>
      </div>
      <div class="exnote" data-a>Dictated mid-exam — no keyboard touched.</div>
    </div>
  </section>

  <!-- SCENE 3 — processing -->
  <section class="scene" id="sc3" data-screen-label="04">
    <div class="procwrap">
      <div class="stg" id="st0"><span class="ic"><span class="sp"></span><span class="ok">✓</span></span>Cleaning transcript</div>
      <div class="stg" id="st1"><span class="ic"><span class="sp"></span><span class="ok">✓</span></span>Structuring note</div>
      <div class="stg" id="st2"><span class="ic"><span class="sp"></span><span class="ok">✓</span></span>Safety review</div>
    </div>
  </section>

  <!-- SCENE 4 — clinical note -->
  <section class="scene" id="sc4" data-screen-label="05"><div class="notewrap">
    <div class="note" data-a>
      <div class="notehd">
        <span class="nt">Clinical Note — Mrs. ___</span>
        <span class="gentag">Generated · review required</span>
      </div>
      <div class="notebody">
        <div data-a>
          <div class="nlab">HISTORY</div>
          <div class="nhist" id="hist">41 F — fever × 3 days, dysuria × 5 days, chills. Recurrent UTI × 1 year — self-medicated from chemist, never cultured. No back pain, no vomiting.</div>
        </div>
        <div data-a>
          <div class="nlab">EXAM</div>
          <div class="nbody">Hypogastric tenderness · no flank tenderness · no pallor · rest normal.</div>
        </div>
        <div data-a>
          <div class="nlab">INVESTIGATIONS</div>
          <div class="nbody">CBC · Urine routine · Urine culture &amp; sensitivity</div>
        </div>
        <div data-a>
          <div class="nlab">MEDICATIONS</div>
          <div class="medrow" data-a><span class="mtag">RX</span>Tab Paracetamol 650 — 1-1-1 × 3 days, then SOS for fever</div>
          <div class="medrow" data-a><span class="mtag">RX</span>Tab Nitrofurantoin 100 — 1-0-1 × 3 days</div>
          <div class="medrow" data-a><span class="mtag">RX</span>Tab Pyridium 200 — 1-1-1 × 2 days</div>
        </div>
        <div data-a>
          <div class="nlab">PLAN</div>
          <div class="nbody">Review in 3 days with C&amp;S report — change or continue antibiotic per sensitivity.</div>
        </div>
      </div>
      <div class="nfoot">Items extracted from transcript. Physician reviews and signs. No clinical decisions made by the system.</div>
    </div>
  </div></section>

  <!-- SCENE 5 — action row -->
  <section class="scene" id="sc5" data-screen-label="06">
    <div class="s5wrap">
      <div class="bigbtn print" data-a>Print prescription<span class="devchip">IN DEVELOPMENT</span></div>
      <div class="bigbtn ghost" data-a>Save as draft<span class="devchip">IN DEVELOPMENT</span></div>
      <div class="tooltip" data-a>Culture pending? Save a draft — update when reports arrive, same day.</div>
      <div class="bigbtn wa" data-a>WhatsApp + Save</div>
      <div class="bigbtn ghost" data-a>Sign off &amp; save</div>
    </div>
  </section>

  <!-- SCENE 6 — printed OPD sheet -->
  <section class="scene" id="sc6" data-screen-label="07">
    <div class="printwrap">
      <div class="devtag" data-a>PRINT — IN DEVELOPMENT</div>
      <div class="sheet" id="sheet" data-a>
        <div class="lhead">
          <div class="cl">Meridian Clinic<i>.</i></div>
          <div class="dr">Dr. ___ · MBBS, MD<br>Reg No. ___</div>
        </div>
        <div class="prow"><span>Mrs. ___ · 41 F</span><span>OPD · 11 Jun 2026</span></div>
        <div class="rxh">℞</div>
        <div class="rxitem" data-a><span class="n">1.</span>Tab Paracetamol 650 — 1-1-1 × 3 days, then SOS for fever</div>
        <div class="rxitem" data-a><span class="n">2.</span>Tab Nitrofurantoin 100 — 1-0-1 × 3 days</div>
        <div class="rxitem" data-a><span class="n">3.</span>Tab Pyridium 200 — 1-1-1 × 2 days</div>
        <div class="rxinv" data-a><b>Investigations:</b> CBC · Urine routine · Urine culture &amp; sensitivity</div>
        <div class="rxrev" data-a>Review in 3 days with culture report.</div>
        <div class="sfoot">
          <span class="sg">Dr. ___</span>
          <span class="st">Generated · review required<br>Signed by physician</span>
        </div>
      </div>
    </div>
  </section>

  <!-- END CARD -->
  <div class="endcard" id="endcard">
    <div class="wm" data-a>LIET<i>.</i></div>
    <div class="sub" data-a>CLINIC SPACE</div>
    <div class="tag" data-a>You talk. LIET writes.</div>
    <div class="site" data-a>liet-research.eu</div>
    <div class="tiny" data-a>Simulated walkthrough · no real patient data.</div>
  </div>

  <!-- REC BAR -->
  <div class="recbar" id="recbar">
    <span class="recpill"><span class="rd"></span>REC <span class="rectime">00:00</span></span>
    <div class="wave" id="wave"></div>
  </div>
</div>

<script>
(function(){
  var stage=document.getElementById('stage');

  /* ---------- scaling (retry on zero-size load race) ---------- */
  function fit(){
    var k=Math.min(window.innerWidth/1080, window.innerHeight/1920);
    if(!k||!isFinite(k)||k<=0){ requestAnimationFrame(fit); return; }
    stage.style.transform='translate(-50%,-50%) scale('+k+')';
  }
  window.addEventListener('resize',fit); fit();

  /* ---------- waveform ---------- */
  var wave=document.getElementById('wave');
  for(var i=0;i<70;i++){
    var b=document.createElement('i');
    b.style.animationDelay=(-(i*0.13)%1).toFixed(2)+'s';
    b.style.animationDuration=(0.55+((i*7)%10)/14).toFixed(2)+'s';
    wave.appendChild(b);
  }

  /* ---------- typing prep ---------- */
  function prep(id){
    var el=document.getElementById(id);
    var words=el.textContent.split(/\s+/).filter(Boolean);
    el.innerHTML=words.map(function(w){return '<span class="w">'+w+'</span>';}).join(' ');
    return el;
  }
  var typedEls={};
  ['t0','t1','t2','t3','t4','t5','t6','hist'].forEach(function(id){ typedEls[id]=prep(id); });

  /* ---------- cue + tween engine ---------- */
  var cues=[], tweens=[], targets=[], SEEKING=false;
  function cue(t,fn){ cues.push({t:t,fn:fn,fired:false}); }
  function ease(p){ return 1-Math.pow(1-p,3); }
  function reg(el){ if(targets.indexOf(el)===-1) targets.push(el); }
  function tw(el,t0,dur,a,b){ tweens.push({el:el,t0:t0,dur:dur,a:a,b:b}); reg(el); }
  function inT(el,t0,dur){ tw(el,t0,dur||550,{o:0,y:26,s:1},{o:1,y:0,s:1}); }
  function fade(el,t0,dur,o0,o1,y0,y1){ tw(el,t0,dur,{o:o0,y:y0||0,s:1},{o:o1,y:y1||0,s:1}); }

  function applyTweens(ms){
    for(var i=0;i<tweens.length;i++){
      var t=tweens[i];
      if(ms<t.t0) continue;
      var p=Math.min(1,(ms-t.t0)/t.dur), e=ease(p);
      var o=t.a.o+(t.b.o-t.a.o)*e;
      var y=t.a.y+(t.b.y-t.a.y)*e;
      t.el.style.opacity=o.toFixed(3);
      t.el.style.transform=y?('translateY('+y.toFixed(1)+'px)'):'none';
    }
  }

  function typeCues(id,t0,msWord){
    var el=typedEls[id];
    var ws=el.querySelectorAll('.w');
    cue(t0,function(){ el.classList.add('go','typing'); });
    for(var i=0;i<ws.length;i++){
      (function(sp,t){ cue(t,function(){ sp.classList.add('s'); }); })(ws[i], t0+i*msWord);
    }
    var end=t0+ws.length*msWord;
    cue(end+150,function(){ el.classList.remove('typing'); });
    return end;
  }

  /* ---------- scenes ---------- */
  var scenes=[0,1,2,3,4,5,6].map(function(i){return document.getElementById('sc'+i);});
  var endcard=document.getElementById('endcard');
  var sceneSpan=[[0,9000],[9000,30000],[30000,34000],[34000,37000],[37000,48000],[48000,52000],[52000,59000]];
  scenes.forEach(function(s,i){
    fade(s, sceneSpan[i][0], 350, 0, 1);
    fade(s, sceneSpan[i][1], 350, 1, 0);
  });

  /* ---------- captions ---------- */
  var capEl=document.getElementById('cap');
  var caps=[
    [400,  "Opens with the patient's own history."],
    [5400, "You talk. LIET writes."],
    [9600, "Captures the consult — in any language."],
    [30300,"Exam findings, captured as you say them."],
    [34200,""],
    [37400,"A complete, structured note — ready to review and sign."],
    [48300,"Culture pending? Save a draft — update when reports arrive, same day."],
    [52300,"A printed prescription on your letterhead — in seconds."],
    [58800,""]
  ];
  caps.forEach(function(c){
    cue(c[0],function(){ capEl.textContent=c[1]; });
    fade(capEl,c[0],380,0,c[1]?1:0);
  });

  /* ---------- ripple ---------- */
  function ripple(el){
    if(SEEKING) return;
    var r=document.createElement('span'); r.className='ripple';
    var br=el.getBoundingClientRect(), sr=stage.getBoundingClientRect();
    var k=sr.width/1080;
    r.style.left=((br.left-sr.left)/k + br.width/k/2)+'px';
    r.style.top=((br.top-sr.top)/k + br.height/k/2)+'px';
    stage.appendChild(r);
    setTimeout(function(){ r.remove(); },600);
  }

  /* =================== TIMELINE =================== */
  var micbig=document.getElementById('micbig'), miczone=document.getElementById('miczone');
  var recbar=document.getElementById('recbar');

  /* SCENE 0 : 0–9000 — patient card, memory strip, mic; tap at 5000 */
  var s0els=scenes[0].querySelectorAll('[data-a]');
  s0els.forEach(function(el,i){ inT(el, 300+i*350); });
  cue(5000,function(){ ripple(micbig); });
  cue(5300,function(){
    micbig.classList.add('rec'); miczone.classList.add('live');
    stage.classList.add('recording');
  });
  fade(recbar,5300,400,0,1,26,0);
  fade(recbar,34000,300,1,0);

  /* SCENE 1 : 9000–30000 — consult */
  inT(scenes[1].querySelector('.tpanel'),9100);
  typeCues('t0',9500,42);
  typeCues('t1',10900,42);
  typeCues('t2',12400,42);
  typeCues('t3',14400,42);
  typeCues('t4',16200,42);
  typeCues('t5',17800,46);
  typeCues('t6',24800,42);
  inT(scenes[1].querySelector('.cappanel'),11200);
  var chips=scenes[1].querySelectorAll('.cchip');
  var chipTimes=[11800,15400,18900,21500,22600,23300];
  chips.forEach(function(el,i){ inT(el,chipTimes[i],420); });

  /* SCENE 2 : 30000–34000 — exam */
  inT(scenes[2].querySelector('.expanel'),30200);
  var exrows=scenes[2].querySelectorAll('.exrow');
  exrows.forEach(function(el,i){ inT(el,30600+i*500,420); });
  inT(scenes[2].querySelector('.exnote'),32800);

  /* SCENE 3 : 34000–37000 — processing */
  cue(33700,function(){ ripple(recbar); });
  cue(34000,function(){ stage.classList.remove('recording'); });
  cue(34300,function(){ document.getElementById('st0').classList.add('run'); });
  cue(35100,function(){ var s=document.getElementById('st0'); s.classList.remove('run'); s.classList.add('done'); document.getElementById('st1').classList.add('run'); });
  cue(35900,function(){ var s=document.getElementById('st1'); s.classList.remove('run'); s.classList.add('done'); document.getElementById('st2').classList.add('run'); });
  cue(36700,function(){ var s=document.getElementById('st2'); s.classList.remove('run'); s.classList.add('done'); });

  /* SCENE 4 : 37000–48000 — note */
  inT(scenes[4].querySelector('.note'),37300,650);
  var nb=scenes[4].querySelectorAll('.notebody > [data-a]');
  inT(nb[0],37700);
  typeCues('hist',37900,24);
  inT(nb[1],39400);
  inT(nb[2],40400);
  inT(nb[3],41400);
  var meds=scenes[4].querySelectorAll('.medrow');
  inT(meds[0],41900,420); inT(meds[1],42600,420); inT(meds[2],43300,420);
  inT(nb[4],44600);

  /* SCENE 5 : 48000–52000 — actions */
  var s5=scenes[5].querySelectorAll('.s5wrap > [data-a]');
  inT(s5[0],48300); inT(s5[1],48650); inT(s5[2],49100); inT(s5[3],49600); inT(s5[4],49950);
  cue(51400,function(){ ripple(scenes[5].querySelector('.bigbtn.print')); });

  /* SCENE 6 : 52000–59000 — printed sheet (hero) */
  inT(scenes[6].querySelector('.devtag'),52200);
  tw(document.getElementById('sheet'),52500,850,{o:0,y:120,s:1},{o:1,y:0,s:1});
  var rx=scenes[6].querySelectorAll('.sheet [data-a]');
  rx.forEach(function(el,i){ inT(el,53400+i*450,420); });

  /* END CARD : 59000→ hold */
  fade(endcard,59000,500,0,1);
  var endEls=endcard.querySelectorAll('[data-a]');
  endEls.forEach(function(el,i){ inT(el,59250+i*180); });

  cues.sort(function(a,b){ return a.t-b.t; });
  tweens.sort(function(a,b){ return a.t0-b.t0; });
  window.__dbg={cues:cues,tweens:tweens,targets:targets};
  window.__state=function(){ return {elapsed:elapsed, playing:playing}; };
  window.__seek=function(t){ seek(t); };

  /* ---------- clock ---------- */
  var startWall=null, elapsed=0, playing=false, raf=null, itv=null;
  var sceneStarts=[0,9000,30000,34000,37000,48000,52000,59000];

  function recDisplay(ms){
    var capMs = Math.min(Math.max(0,ms-5300), 34000-5300);
    var secs=Math.floor(capMs/1000);
    var m=Math.floor(secs/60), s=secs%60;
    return (m<10?'0':'')+m+':'+(s<10?'0':'')+s;
  }
  function frame(){
    for(var i=0;i<cues.length;i++){
      if(!cues[i].fired && cues[i].t<=elapsed){ cues[i].fired=true; cues[i].fn(); }
    }
    applyTweens(elapsed);
    var t=recDisplay(elapsed);
    var tEls=document.querySelectorAll('.rectime');
    for(var j=0;j<tEls.length;j++) tEls[j].textContent=t;
  }
  function tickNow(now){
    if(!playing) return;
    elapsed = now - startWall;
    frame();
  }
  function tick(now){
    if(!playing) return;
    tickNow(now);
    raf=requestAnimationFrame(tick);
  }
  function play(){
    if(playing) return;
    fit();
    playing=true; stage.classList.remove('paused');
    startWall=performance.now()-elapsed;
    raf=requestAnimationFrame(tick);
    itv=setInterval(function(){ tickNow(performance.now()); },33);
  }
  function pause(){
    playing=false; stage.classList.add('paused');
    if(raf) cancelAnimationFrame(raf);
    if(itv){ clearInterval(itv); itv=null; }
  }

  function resetDom(){
    targets.forEach(function(el){ el.style.opacity=''; el.style.transform=''; });
    document.querySelectorAll('.tl').forEach(function(el){ el.classList.remove('go','typing'); });
    document.querySelectorAll('.w.s').forEach(function(el){ el.classList.remove('s'); });
    document.querySelectorAll('.stg').forEach(function(el){ el.classList.remove('run','done'); });
    micbig.classList.remove('rec'); miczone.classList.remove('live');
    stage.classList.remove('recording');
    capEl.textContent='';
  }
  function seek(t){
    pause();
    resetDom();
    SEEKING=true;
    for(var i=0;i<cues.length;i++){
      cues[i].fired = cues[i].t < t;
      if(cues[i].fired) cues[i].fn();
    }
    SEEKING=false;
    elapsed=t;
    frame();
    play();
  }
  function curScene(){
    var n=0;
    for(var i=0;i<sceneStarts.length;i++){ if(elapsed>=sceneStarts[i]) n=i; }
    return n;
  }

  document.addEventListener('keydown',function(e){
    if(e.code==='Space'){ e.preventDefault(); playing?pause():play(); }
    else if(e.key==='r'||e.key==='R'){ seek(0); }
    else if(e.key==='ArrowRight'){ e.preventDefault(); seek(sceneStarts[Math.min(sceneStarts.length-1,curScene()+1)]); }
    else if(e.key==='ArrowLeft'){ e.preventDefault(); seek(sceneStarts[Math.max(0,curScene()-1)]); }
  });

  frame();
  setTimeout(play,1000);
})();
</script>
</body>
</html>
